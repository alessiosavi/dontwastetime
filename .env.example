# Copy to .env (gitignored) and fill. Env always wins over config.json.
# Microsoft Graph app-only credential (copied by hand from internal's local .env).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# OpenAI-compatible classifier endpoint (Azure AI Foundry, EU hosting).
LLM_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional overrides.
# LLM_DAILY_MAX_TOKENS=2000000
# llm.monthly_max_cost: estimated USD per Europe/Rome calendar month; 0 disables.
# LLM_MONTHLY_MAX_COST=10
# llm.price_in_per_mtok / llm.price_out_per_mtok: USD per million tokens.
# Finite, non-negative prices; a monthly cap needs at least one non-zero price.
# LLM_PRICE_IN_PER_MTOK=0.30
# LLM_PRICE_OUT_PER_MTOK=1.20
# DWT_STATE_DIR=
