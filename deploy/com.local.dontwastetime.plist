<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: `make install-agent` fills the __DWT_*__ placeholders. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.dontwastetime</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DWT_BIN__</string>
    <string>serve</string>
    <string>--config</string>
    <string>__DWT_DIR__/config.json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DWT_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__DWT_LOGS__/dwt.out.log</string>
  <key>StandardErrorPath</key>
  <string>__DWT_LOGS__/dwt.err.log</string>
</dict>
</plist>
